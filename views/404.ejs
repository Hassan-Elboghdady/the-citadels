<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= t.dir %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <title><%= title %></title>
  <meta name="robots" content="noindex">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">
    <section style="min-height: 60vh; display: flex; align-items: center; padding: 120px 0;">
      <div class="container" style="max-width: 560px;">
        <span class="eyebrow"><%= t.error404.eyebrow %></span>
        <h1 style="margin-bottom: 20px;"><%= t.error404.h1 %></h1>
        <p class="lead" style="margin-bottom: 36px;"><%= t.error404.desc %></p>
        <a href="<%= lang === 'en' ? '/' : '/' + lang %>" class="btn btn--dark" id="home-link-404"><%= t.error404.button %></a>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
