<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= t.dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/about.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <!-- Intro -->
    <section class="about-hero">
      <div class="container">
        <div class="about-hero__inner">
          <div class="about-hero__left">
            <span class="about-hero__label"><%= t.about.heroLabel %></span>
            <h1><%- t.about.heroH1 %></h1>
          </div>
          <div class="about-hero__right">
            <span class="about-hero__rule" aria-hidden="true"></span>
            <p class="about-hero__lead"><%= t.about.heroLead %></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Story -->
    <section class="about-story" aria-labelledby="story-heading">
      <div class="container">
        <div class="about-story__grid">
          <div class="about-story__left">
            <h2 id="story-heading"><%= t.about.storyHeading %></h2>
          </div>
          <div class="about-story__right">
            <p><%= t.about.storyP1 %></p>
            <p><%= t.about.storyP2 %></p>
            <p><%= t.about.storyP3 %></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Vision & Mission -->
    <section class="about-vm" aria-labelledby="vision-heading">
      <div class="container">
        <div class="about-vm__grid">
          <div class="about-vm__block">
            <span class="about-vm__label"><%= t.about.visionLabel %></span>
            <h2 id="vision-heading"><%= t.about.visionHeading %></h2>
            <p><%= t.about.visionText %></p>
          </div>
          <div class="about-vm__divider" aria-hidden="true"></div>
          <div class="about-vm__block">
            <span class="about-vm__label"><%= t.about.missionLabel %></span>
            <h3><%= t.about.missionHeading %></h3>
            <p><%= t.about.missionText %></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="about-values" aria-labelledby="values-heading">
      <div class="container">
        <h2 id="values-heading" class="about-values__heading"><%= t.about.valuesHeading %></h2>
        <div class="about-values__grid">
          <div class="about-values__item">
            <h3><%= t.about.val1Title %></h3>
            <p><%= t.about.val1Text %></p>
          </div>
          <div class="about-values__item">
            <h3><%= t.about.val2Title %></h3>
            <p><%= t.about.val2Text %></p>
          </div>
          <div class="about-values__item">
            <h3><%= t.about.val3Title %></h3>
            <p><%= t.about.val3Text %></p>
          </div>
          <div class="about-values__item">
            <h3><%= t.about.val4Title %></h3>
            <p><%= t.about.val4Text %></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sectors -->
    <section class="about-sectors" aria-labelledby="sectors-heading">
      <div class="container">
        <div class="about-sectors__header">
          <h2 id="sectors-heading"><%= t.about.sectorsHeading %></h2>
          <span class="about-sectors__count"><%= t.about.sectorsCount %></span>
        </div>
        <div class="about-sectors__list">
          <div class="about-sectors__item">
            <span class="about-sectors__item-num">01</span>
            <div>
              <h3><%= t.about.sec1Title %></h3>
              <p><%= t.about.sec1Text %></p>
            </div>
          </div>
          <div class="about-sectors__item">
            <span class="about-sectors__item-num">02</span>
            <div>
              <h3><%= t.about.sec2Title %></h3>
              <p><%= t.about.sec2Text %></p>
            </div>
          </div>
          <div class="about-sectors__item">
            <span class="about-sectors__item-num">03</span>
            <div>
              <h3><%= t.about.sec3Title %></h3>
              <p><%= t.about.sec3Text %></p>
            </div>
          </div>
          <div class="about-sectors__item">
            <span class="about-sectors__item-num">04</span>
            <div>
              <h3><%= t.about.sec4Title %></h3>
              <p><%= t.about.sec4Text %></p>
            </div>
          </div>
          <div class="about-sectors__item">
            <span class="about-sectors__item-num">05</span>
            <div>
              <h3><%= t.about.sec5Title %></h3>
              <p><%= t.about.sec5Text %></p>
            </div>
          </div>
          <div class="about-sectors__item">
            <span class="about-sectors__item-num">06</span>
            <div>
              <h3><%= t.about.sec6Title %></h3>
              <p><%= t.about.sec6Text %></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-band" aria-labelledby="about-cta-heading">
      <div class="container">
        <div class="cta-band__inner">
          <div class="cta-band__left">
            <h2 id="about-cta-heading"><%- t.about.ctaHeading %></h2>
          </div>
          <div class="cta-band__right">
            <p><%= t.about.ctaText %></p>
            <div class="btn-row">
              <a href="<%= pfx %>/contact" class="btn btn--accent" id="about-cta-contact"><%= t.about.ctaContact %></a>
              <a href="/brochure/the-citadels-brochure.pdf" target="_blank" rel="noopener noreferrer" class="btn btn--ghost" id="about-cta-brochure"><%= t.about.ctaBrochure %></a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.js"></script>
</body>
</html>
