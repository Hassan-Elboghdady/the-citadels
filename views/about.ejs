<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/about.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <!-- Intro -->
    <section class="about-hero">
      <div class="about-hero__image-col">
        <img src="/images/hotel.png" alt="Premium furniture showroom interior with elegant seating" class="about-hero__img">
      </div>
      <div class="about-hero__content-col">
        <span class="eyebrow">About us</span>
        <h1>Built on Trust,<br>Driven by Quality</h1>
        <p class="lead">The Citadels is a family-owned company with a proven track record in engineering, contracting, fit-out, and furniture solutions across Egypt.</p>
      </div>
    </section>

    <!-- Story -->
    <section class="about-story" aria-labelledby="story-heading">
      <div class="container">
        <div class="about-story__grid">
          <div class="about-story__left">
            <h2 id="story-heading">Who We Are</h2>
          </div>
          <div class="about-story__right">
            <p>Founded in 2009, The Citadels has grown from a focused contracting firm into a comprehensive furniture and project solutions company serving clients across Egypt.</p>
            <p>We specialize in sourcing, importing, and delivering premium furniture for environments that demand quality: hospitals, railways, hotels, offices, control rooms, airports, and private residences.</p>
            <p>As a family-owned business, our reputation is built on personal accountability. Every project receives the attention and commitment that only a dedicated ownership structure can provide.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Vision & Mission -->
    <section class="about-vm" aria-labelledby="vision-heading">
      <div class="container">
        <div class="about-vm__grid">
          <div class="about-vm__block">
            <span class="about-vm__label">Vision</span>
            <h2 id="vision-heading">Where We Are Headed</h2>
            <p>To be Egypt's most trusted source for premium imported furniture and project solutions, setting the standard for quality, reliability, and client service in every sector we serve.</p>
          </div>
          <div class="about-vm__divider" aria-hidden="true"></div>
          <div class="about-vm__block">
            <span class="about-vm__label">Mission</span>
            <h3>What Drives Us</h3>
            <p>To deliver furniture solutions that combine international quality with local expertise. We source the best products from selected global partners and support our clients from initial design coordination through installation and after-sales service.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="about-values" aria-labelledby="values-heading">
      <div class="container">
        <h2 id="values-heading" class="about-values__heading">Company Values</h2>
        <div class="about-values__grid">
          <div class="about-values__item">
            <span class="about-values__num">01</span>
            <h3>Quality</h3>
            <p>We source only from manufacturers and partners whose products meet international standards of durability, safety, and design.</p>
          </div>
          <div class="about-values__item">
            <span class="about-values__num">02</span>
            <h3>Reliability</h3>
            <p>We honor commitments on timelines, specifications, and budgets. Our clients depend on us for projects with strict deadlines.</p>
          </div>
          <div class="about-values__item">
            <span class="about-values__num">03</span>
            <h3>Integrity</h3>
            <p>As a family-owned company, our name is on every project. We operate with transparency and take personal responsibility for outcomes.</p>
          </div>
          <div class="about-values__item">
            <span class="about-values__num">04</span>
            <h3>Partnership</h3>
            <p>We work with clients as long-term partners, providing ongoing support well beyond the initial delivery and installation.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sectors -->
    <section class="about-sectors" aria-labelledby="sectors-heading">
      <div class="container">
        <div class="about-sectors__header">
          <h2 id="sectors-heading">Sectors We Serve</h2>
        </div>
        <div class="about-sectors__list">
          <div class="about-sectors__item">
            <span class="about-sectors__item-num">01</span>
            <div>
              <h3>Healthcare & Laboratory</h3>
              <p>Specialized furniture for hospitals, clinics, proton therapy centers, and laboratory environments.</p>
            </div>
          </div>
          <div class="about-sectors__item">
            <span class="about-sectors__item-num">02</span>
            <div>
              <h3>Railway & Transport</h3>
              <p>Control room consoles, station furniture, and ergonomic operator workstations for monorail and rail systems.</p>
            </div>
          </div>
          <div class="about-sectors__item">
            <span class="about-sectors__item-num">03</span>
            <div>
              <h3>Hospitality</h3>
              <p>Guest room furniture, lobby seating, restaurant furnishings, and conference room solutions for hotels.</p>
            </div>
          </div>
          <div class="about-sectors__item">
            <span class="about-sectors__item-num">04</span>
            <div>
              <h3>Office</h3>
              <p>Executive furniture, modular workstations, and ergonomic solutions from leading international office brands.</p>
            </div>
          </div>
          <div class="about-sectors__item">
            <span class="about-sectors__item-num">05</span>
            <div>
              <h3>Residential</h3>
              <p>Premium imported furniture for living rooms, bedrooms, dining areas, and private villas.</p>
            </div>
          </div>
          <div class="about-sectors__item">
            <span class="about-sectors__item-num">06</span>
            <div>
              <h3>Airport & Aviation</h3>
              <p>Seating, check-in counters, and gate area equipment designed for high-traffic aviation environments.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-band" aria-labelledby="about-cta-heading">
      <div class="container">
        <div class="cta-band__inner">
          <div class="cta-band__left">
            <h2 id="about-cta-heading">Work<br>With Us</h2>
          </div>
          <div class="cta-band__right">
            <p>Whether you are furnishing a single office or outfitting an entire facility, our team is ready to help.</p>
            <div class="btn-row">
              <a href="/contact" class="btn btn--accent" id="about-cta-contact">Contact Us</a>
              <a href="/collections" class="btn btn--ghost" id="about-cta-collections">View Collections</a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.js"></script>
</body>
</html>
