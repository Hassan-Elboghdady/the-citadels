<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="robots" content="noindex">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/collections.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <div class="page-intro">
      <div class="container">
        <span class="eyebrow">Your Selection</span>
        <h1>Shopping Cart</h1>
      </div>
    </div>

    <section class="cart-section" aria-labelledby="cart-heading">
      <div class="container">
        <h2 id="cart-heading" class="sr-only">Cart Items</h2>

        <!-- Empty state -->
        <div class="cart-empty" id="cart-empty" style="display: none;">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M6 6h6l6 24h18l6-18H18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="20" cy="40" r="3" stroke="currentColor" stroke-width="2"/><circle cx="34" cy="40" r="3" stroke="currentColor" stroke-width="2"/></svg>
          <p>Your cart is empty.</p>
          <a href="/collections" class="btn btn--dark">Browse Collections</a>
        </div>

        <!-- Cart contents -->
        <div class="cart-content" id="cart-content" style="display: none;">
          <div class="cart-layout">
            <div class="cart-items" id="cart-items">
              <!-- Populated by JS -->
            </div>
            <aside class="cart-summary" id="cart-summary">
              <h3>Order Summary</h3>
              <div class="cart-summary__row">
                <span>Subtotal</span>
                <span id="cart-subtotal">0 EGP</span>
              </div>
              <div class="cart-summary__row cart-summary__row--total">
                <span>Total</span>
                <span id="cart-total">0 EGP</span>
              </div>
              <p class="cart-summary__note">Shipping and taxes calculated at checkout. For large orders or project pricing, please <a href="/contact">contact us</a>.</p>
              <a href="/contact" class="btn btn--dark" style="width: 100%; margin-top: 16px;" id="cart-checkout">Proceed to Inquiry</a>
              <a href="/collections" class="btn btn--outline" style="width: 100%; margin-top: 8px;">Continue Shopping</a>
            </aside>
          </div>
        </div>

      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
  <script src="/js/cart.js"></script>
</body>
</html>
