<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/collections.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <div class="page-intro">
      <div class="container">
        <span class="eyebrow">Our Products</span>
        <h1>Furniture Collections</h1>
        <p class="lead">Premium imported furniture for every environment, sourced from selected international manufacturers and partners.</p>
      </div>
    </div>

    <!-- Category filter tabs -->
    <section class="coll-filter" aria-label="Filter by category">
      <div class="container">
        <div class="coll-filter__tabs" role="tablist">
          <button class="coll-filter__tab coll-filter__tab--active" role="tab" data-category="all" aria-selected="true" id="tab-all">All</button>
          <% categories.forEach(function(cat) { %>
            <button class="coll-filter__tab" role="tab" data-category="<%= cat.slug %>" aria-selected="false" id="tab-<%= cat.slug %>"><%= cat.label %></button>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Product grid -->
    <section class="products-section" aria-labelledby="products-heading">
      <div class="container">
        <h2 id="products-heading" class="sr-only">Products</h2>
        <div class="products-grid" id="products-grid">
          <% products.forEach(function(product) { %>
            <article class="product-card" data-category="<%= product.category %>" id="product-<%= product.id %>">
              <div class="product-card__img-wrap">
                <img src="<%= product.image %>" alt="<%= product.name %>" class="product-card__img" loading="lazy">
                <span class="product-card__badge"><%= product.categoryLabel %></span>
              </div>
              <div class="product-card__body">
                <h3 class="product-card__name"><%= product.name %></h3>
                <p class="product-card__desc"><%= product.description.substring(0, 100) %>...</p>
                <div class="product-card__footer">
                  <span class="product-card__price"><%= product.price.toLocaleString() %> EGP</span>
                  <div class="product-card__actions">
                    <a href="/product/<%= product.id %>" class="btn btn--outline btn--sm" id="view-<%= product.id %>">View Details</a>
                    <button type="button" class="btn btn--dark btn--sm btn-add-cart" data-product-id="<%= product.id %>" data-product-name="<%= product.name %>" data-product-price="<%= product.price %>" data-product-image="<%= product.image %>" id="cart-<%= product.id %>">Add to Cart</button>
                  </div>
                </div>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Partners -->
    <section class="partners-section" aria-labelledby="partners-heading">
      <div class="container">
        <div class="partners-header">
          <h2 id="partners-heading">International Partners</h2>
          <p class="lead">We work with selected manufacturers to source furniture that meets strict standards for quality, durability, and design.</p>
        </div>
        <div class="partners-grid">
          <div class="partner-card">
            <h3>ABLE</h3>
            <p>Hotel & Residential Furniture</p>
          </div>
          <div class="partner-card">
            <h3>Zivella</h3>
            <p>Office Furniture</p>
          </div>
          <div class="partner-card">
            <h3>Falmar</h3>
            <p>Office Furniture</p>
          </div>
          <div class="partner-card">
            <h3>Elettromeccanica Bosco</h3>
            <p>Control Room Furniture</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-band" aria-labelledby="collections-cta-heading">
      <div class="container">
        <div class="cta-band__inner">
          <div class="cta-band__left">
            <h2 id="collections-cta-heading">Need a Specific<br>Solution?</h2>
          </div>
          <div class="cta-band__right">
            <p>Tell us about your project requirements. Our team will provide a detailed proposal including product specifications, pricing, and delivery timelines.</p>
            <div class="btn-row">
              <a href="/contact" class="btn btn--accent" id="collections-cta-contact">Contact Us</a>
              <a href="/projects" class="btn btn--ghost" id="collections-cta-projects">View Our Projects</a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.js"></script>
  <script src="/js/cart.js"></script>
</body>
</html>
