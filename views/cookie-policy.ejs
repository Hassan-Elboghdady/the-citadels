<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= t.dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <meta name="description" content="<%= description %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/legal.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">
    <div class="page-intro">
      <div class="container container--tight">
        <h1><%- t.cookies.h1 %></h1>
        <p class="legal-date"><%- t.cookies.updated %></p>
      </div>
    </div>

    <section class="legal-body">
      <div class="container container--tight">
        <article class="legal-content">

          <h2><%- t.cookies.s1H %></h2>
          <p><%- t.cookies.s1P %></p>

          <h2><%- t.cookies.s2H %></h2>
          <p><%- t.cookies.s2P %></p>
          <h3><%- t.cookies.essentialH %></h3>
          <table class="legal-table">
            <thead>
              <tr>
                <th><%- t.cookies.thName %></th>
                <th><%- t.cookies.thPurpose %></th>
                <th><%- t.cookies.thDuration %></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>cookie_consent</td>
                <td><%- t.cookies.consentPurpose %></td>
                <td><%- t.cookies.consentDuration %></td>
              </tr>
            </tbody>
          </table>
          <p><%- t.cookies.essentialNote %></p>
          <h3><%- t.cookies.analyticsH %></h3>
          <p><%- t.cookies.analyticsP %></p>
          <table class="legal-table">
            <thead>
              <tr>
                <th><%- t.cookies.thName %></th>
                <th><%- t.cookies.thPurpose %></th>
                <th><%- t.cookies.thDuration %></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>_ga</td>
                <td><%- t.cookies.gaPurpose %></td>
                <td><%- t.cookies.twoYears %></td>
              </tr>
              <tr>
                <td>_ga_*</td>
                <td><%- t.cookies.gaSessionPurpose %></td>
                <td><%- t.cookies.twoYears %></td>
              </tr>
            </tbody>
          </table>
          <p><%- t.cookies.analyticsNote %></p>

          <h2><%- t.cookies.s3H %></h2>
          <p><%- t.cookies.s3P %></p>

          <h2><%- t.cookies.s4H %></h2>
          <p><%- t.cookies.s4Intro %></p>
          <ul>
            <li><%- t.cookies.s4L1 %></li>
            <li><%- t.cookies.s4L2 %></li>
          </ul>
          <p><%- t.cookies.s4P %></p>

          <h2><%- t.cookies.s5H %></h2>
          <p><%- t.cookies.s5P %></p>

          <h2><%- t.cookies.s6H %></h2>
          <p><%- t.cookies.s6P %></p>
          <div class="legal-address">
            <p><strong><%- t.legal.company %></strong></p>
            <p><%- t.legal.phone %>: <a href="tel:+201069631049">+20 106 963 1049</a></p>
            <p><%- t.legal.phone %>: <a href="tel:+201200142107">+20 120 014 2107</a></p>
            <p><%- t.legal.whatsapp %>: <a href="https://wa.me/201069631049">+20 106 963 1049</a></p>
            <p><%- t.legal.email %>: <a href="mailto:info@thecitadels.com">info@thecitadels.com</a></p>
          </div>

        </article>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.js"></script>
</body>
</html>
