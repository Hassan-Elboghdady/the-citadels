<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= t.dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <meta name="description" content="<%= description %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/main.min.css?v=9">
  <link rel="stylesheet" href="/css/home.min.css?v=12">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <!-- ========== HERO ========== -->
    <section class="hero" aria-label="Introduction">
      <div class="hero__inner">
        
        <h1><%- t.home.heroH1 %></h1>
        <div class="hero__rule" aria-hidden="true"></div>
        <p class="hero__sub"><%- t.home.heroSub %></p>
        <div class="btn-row">
          <a href="<%= pfx %>/projects" class="btn btn--dark" id="hero-cta-our-projects"><%= t.home.heroBtn1 %></a>
        </div>
      </div>
    </section>

    <!-- ========== PARTNERS ========== -->
    <section class="partners-section" aria-labelledby="partners-heading">
      <div class="container">
        <h2 id="partners-heading" class="partners-section__title"><%= t.home.partnersTitle %></h2>
        <div class="partners-grid">
          <a href="https://ablebemodern.com/" target="_blank" rel="noopener noreferrer" aria-label="Visit ABLE website">
            <img src="/images/partners/Able-Partner.webp" alt="Able" class="partner-logo" loading="lazy" decoding="async">
          </a>
          <a href="https://www.elettrobosco.com/en/" target="_blank" rel="noopener noreferrer" aria-label="Visit Bosco website">
            <img src="/images/partners/Bosco-Partner.webp" alt="Bosco" class="partner-logo" loading="lazy" decoding="async">
          </a>
          <a href="https://falmar.it/" target="_blank" rel="noopener noreferrer" aria-label="Visit Falmar website">
            <img src="/images/partners/Falmar-Partner.webp" alt="Falmar" class="partner-logo" loading="lazy" decoding="async">
          </a>
          <a href="https://www.zivella.com/" target="_blank" rel="noopener noreferrer" aria-label="Visit Zivella website">
            <img src="/images/partners/Zivella-Partner.webp" alt="Zivella" class="partner-logo" loading="lazy" decoding="async">
          </a>
        </div>
      </div>
    </section>

    <!-- ========== BROCHURE CTA ========== -->
    <section class="brochure-band" aria-label="Download Company Brochure">
      <div class="container">
        <div class="brochure-band__inner">
          <div class="brochure-band__line" aria-hidden="true"></div>
          <div class="brochure-band__body">
            <span class="brochure-band__eyebrow"><%= t.home.brochureEyebrow %></span>
            <a href="/brochure/the-citadels-brochure.pdf" target="_blank" rel="noopener noreferrer" class="brochure-band__btn" id="home-brochure-cta">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <%= t.home.brochureBtn %>
            </a>

            <!-- Partner brochures -->
            
        </div>
      </div>
    </section>

    <!-- ========== TRUST STRIP ========== -->
    <section class="trust-strip" aria-labelledby="trust-heading">
      <div class="container">
        <h2 id="trust-heading"><%= t.home.trustTitle %></h2>
        <div class="trust-strip__grid">
          <div class="trust-item">
            <h3 class="trust-item__title"><%= t.home.trust1Title %></h3>
            <p class="trust-item__text"><%= t.home.trust1Text %></p>
          </div>
          <div class="trust-item">
            <h3 class="trust-item__title"><%= t.home.trust2Title %></h3>
            <p class="trust-item__text"><%= t.home.trust2Text %></p>
          </div>
          <div class="trust-item">
            <h3 class="trust-item__title"><%= t.home.trust3Title %></h3>
            <p class="trust-item__text"><%= t.home.trust3Text %></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== PROJECTS ========== -->
    

    <!-- ========== ABOUT PREVIEW ========== -->
   

    <!-- ========== CONTACT CTA ========== -->
    

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.min.js"></script>
</body>
</html>
