<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= t.dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <meta name="description" content="<%= description %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/home.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <!-- ========== HERO ========== -->
    <section class="hero" aria-label="Introduction">
      <div class="hero__image-wrap">
        <img src="/images/hero-office.png" alt="Premium modern open-plan office space" class="hero__image">
      </div>
      <div class="hero__content">
        <div class="hero__text">
          <h1><%- t.home.heroH1 %></h1>
          <p class="hero__sub"><%- t.home.heroSub %></p>
          <div class="btn-row">
            <a href="<%= pfx %>/projects" class="btn btn--dark" id="hero-cta-our-projects"><%= t.home.heroBtn1 %></a>
            <a href="<%= pfx %>/contact" class="btn btn--outline" id="hero-cta-contact"><%= t.home.heroBtn2 %></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== PARTNERS ========== -->
    <section class="partners-section" aria-labelledby="partners-heading">
      <div class="container">
        <h2 id="partners-heading" class="partners-section__title"><%= t.home.partnersTitle %></h2>
        <div class="partners-grid">
          <a href="https://ablebemodern.com/" target="_blank" rel="noopener noreferrer" aria-label="Visit ABLE website">
            <img src="/images/partners/Able-Partner.png" alt="Able Partner" class="partner-logo">
          </a>
          <a href="https://www.elettrobosco.com/en/" target="_blank" rel="noopener noreferrer" aria-label="Visit Bosco website">
            <img src="/images/partners/Bosco-Partner.png" alt="Bosco Partner" class="partner-logo">
          </a>
          <a href="https://falmar.it/" target="_blank" rel="noopener noreferrer" aria-label="Visit Falmar website">
            <img src="/images/partners/Falmar-Partner.png" alt="Falmar Partner" class="partner-logo">
          </a>
          <a href="https://www.zivella.com/" target="_blank" rel="noopener noreferrer" aria-label="Visit Zivella website">
            <img src="/images/partners/Zivella-Partner.png" alt="Zivella Partner" class="partner-logo">
          </a>
        </div>
      </div>
    </section>

    <!-- ========== BROCHURE CTA ========== -->
    <section class="brochure-band" aria-label="Download Company Brochure">
      <div class="container">
        <div class="brochure-band__inner">
          <div class="brochure-band__line" aria-hidden="true"></div>
          <div class="brochure-band__body">
            <span class="brochure-band__eyebrow"><%= t.home.brochureEyebrow %></span>
            <h2 class="brochure-band__heading"><%= t.home.brochureHeading %></h2>
            <a href="/brochure/the-citadels-brochure.pdf" target="_blank" rel="noopener noreferrer" class="brochure-band__btn" id="home-brochure-cta">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <%= t.home.brochureBtn %>
            </a>
          </div>
          <div class="brochure-band__line" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <!-- ========== TRUST STRIP ========== -->
    <section class="trust-strip" aria-labelledby="trust-heading">
      <div class="container">
        <h2 id="trust-heading"><%= t.home.trustTitle %></h2>
        <div class="trust-strip__grid">
          <div class="trust-item">
            <h3 class="trust-item__title"><%= t.home.trust1Title %></h3>
            <p class="trust-item__text"><%= t.home.trust1Text %></p>
          </div>
          <div class="trust-item">
            <h3 class="trust-item__title"><%= t.home.trust2Title %></h3>
            <p class="trust-item__text"><%= t.home.trust2Text %></p>
          </div>
          <div class="trust-item">
            <h3 class="trust-item__title"><%= t.home.trust3Title %></h3>
            <p class="trust-item__text"><%= t.home.trust3Text %></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== PROJECTS ========== -->
    <section class="projects-section" aria-labelledby="projects-heading">
      <div class="container">
        <div class="projects-header">
          <div class="projects-header__left">
            <span class="eyebrow"><%= t.home.projectsEyebrow %></span>
            <h2 id="projects-heading"><%- t.home.projectsHeading %></h2>
          </div>
          <div class="projects-header__right">
            <p class="lead"><%= t.home.projectsLead %></p>
            <a href="<%= pfx %>/projects" class="arrow-link"><%= t.home.projectsLink %></a>
          </div>
        </div>
        <div class="project-row">
          <article class="project-tile">
            <a href="<%= pfx %>/projects/ncc-monorail-depot-buildings" class="project-tile__img-wrap" style="display: block;">
              <img src="/images/our-projects/ncc-monorail-depot-buildings/100_4770.JPG" alt="NCC Monorail Depot Buildings" class="project-tile__img">
            </a>
            <div class="project-tile__info">
              <span class="project-tile__tag"><%= t.home.proj1Tag %></span>
              <a href="<%= pfx %>/projects/ncc-monorail-depot-buildings" style="text-decoration: none; color: inherit;">
                <h3><%= t.home.proj1Title %></h3>
              </a>
              <p class="project-tile__subtitle"><%= t.projects.proj1Subtitle %></p>
              <p class="muted"><%= t.home.proj1Loc %></p>
            </div>
          </article>
          <article class="project-tile">
            <a href="<%= pfx %>/projects/ncc-monorail-stations" class="project-tile__img-wrap" style="display: block;">
              <img src="/images/our-projects/ncc-monorail-stations/STATION ELEVATION.JPG" alt="NCC Monorail Stations" class="project-tile__img">
            </a>
            <div class="project-tile__info">
              <span class="project-tile__tag"><%= t.home.proj2Tag %></span>
              <a href="<%= pfx %>/projects/ncc-monorail-stations" style="text-decoration: none; color: inherit;">
                <h3><%= t.home.proj2Title %></h3>
              </a>
              <p class="project-tile__subtitle"><%= t.projects.proj2Subtitle %></p>
              <p class="muted"><%= t.home.proj2Loc %></p>
            </div>
          </article>
          <article class="project-tile">
            <a href="<%= pfx %>/projects/west-nile-monorail" class="project-tile__img-wrap" style="display: block;">
              <img src="/images/our-projects/west-nile-monorail/mono.jpg" alt="West Nile Monorail" class="project-tile__img">
            </a>
            <div class="project-tile__info">
              <span class="project-tile__tag"><%= t.home.proj3Tag %></span>
              <a href="<%= pfx %>/projects/west-nile-monorail" style="text-decoration: none; color: inherit;">
                <h3><%= t.home.proj3Title %></h3>
              </a>
              <p class="project-tile__subtitle"><%= t.projects.proj3Subtitle %></p>
              <p class="muted"><%= t.home.proj3Loc %></p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== ABOUT PREVIEW ========== -->
    <section class="about-band" aria-labelledby="about-heading">
      <div class="about-band__image-col">
        <img src="\images\our-projects\west-nile-monorail\mono.jpg" alt="Premium furniture showroom with luxury seating and warm interior lighting" class="about-band__img">
      </div>
      <div class="about-band__content-col">
        <span class="eyebrow"><%= t.home.aboutEyebrow %></span>
        <h2 id="about-heading"><%= t.home.aboutHeading %></h2>
        <p class="lead"><%= t.home.aboutP1 %></p>
        <p class="lead"><%= t.home.aboutP2 %></p>
        <a href="<%= pfx %>/about" class="arrow-link" id="home-about-link"><%= t.home.aboutLink %></a>
      </div>
    </section>

    <!-- ========== CONTACT CTA ========== -->
    <section class="cta-band" aria-labelledby="cta-heading">
      <div class="container">
        <div class="cta-band__inner">
          <div class="cta-band__left">
            <h2 id="cta-heading"><%- t.home.ctaH2 %></h2>
          </div>
          <div class="cta-band__right">
            <p><%= t.home.ctaP %></p>
            <div class="btn-row">
              <a href="<%= pfx %>/contact" class="btn btn--accent" id="cta-contact"><%= t.home.ctaBtn1 %></a>
              <a href="https://maps.google.com/?q=Shop+3+Khaled+Ibn+El+Walid+Sheraton+Al+Matar+Cairo" class="btn btn--ghost" id="cta-showroom" target="_blank" rel="noopener noreferrer"><%= t.home.ctaBtn2 %></a>
              <a href="https://wa.me/201069631049" class="btn btn--ghost" id="cta-whatsapp" target="_blank" rel="noopener noreferrer"><%= t.home.ctaBtn3 %></a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.js"></script>
</body>
</html>
