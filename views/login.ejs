<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="Sign in to your account at The Citadels.">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">
    <section class="auth-section" aria-labelledby="login-heading">
      <div class="container">
        <div class="auth-layout">

          <!-- Left: branding panel -->
          <div class="auth-brand">
            <img src="/images/logo.png" alt="The Citadels" class="auth-brand__logo">
            <p class="auth-brand__text">Sign in to manage your project inquiries, view quotes, and access your account.</p>
          </div>

          <!-- Right: form -->
          <div class="auth-form-wrap">
            <h1 id="login-heading" class="auth-title">Sign In</h1>
            <p class="auth-subtitle">New to The Citadels? <a href="/signup">Create an account</a></p>

            <% if (errors.general) { %>
              <div class="auth-alert auth-alert--error" role="alert">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M10 6v5M10 13.5v.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <%= errors.general %>
              </div>
            <% } %>

            <form class="auth-form" id="login-form" action="/login" method="POST" novalidate>

              <div class="form-group">
                <label for="login-email" class="form-label form-label--required">Email Address</label>
                <input type="email" id="login-email" name="email" class="form-input<%= errors.email ? ' form-input--error' : '' %>" required autocomplete="email" value="<%= formData.email || '' %>">
                <% if (errors.email) { %><p class="form-error" role="alert"><%= errors.email %></p><% } %>
              </div>

              <div class="form-group">
                <label for="login-password" class="form-label form-label--required">Password</label>
                <div class="password-wrap">
                  <input type="password" id="login-password" name="password" class="form-input<%= errors.password ? ' form-input--error' : '' %>" required autocomplete="current-password">
                  <button type="button" class="password-toggle" aria-label="Show password" data-target="login-password">
                    <svg class="eye-open" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M1 10s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6z" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="10" r="3" stroke="currentColor" stroke-width="1.5"/></svg>
                    <svg class="eye-closed" width="18" height="18" viewBox="0 0 20 20" fill="none" style="display:none"><path d="M1 10s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6z" stroke="currentColor" stroke-width="1.5"/><path d="M3 3l14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  </button>
                </div>
                <% if (errors.password) { %><p class="form-error" role="alert"><%= errors.password %></p><% } %>
              </div>

              <button type="submit" class="btn btn--dark auth-submit" id="login-submit">Sign In</button>
            </form>
          </div>

        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
  <script src="/js/auth.js"></script>
</body>
</html>
