<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= t.dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <meta name="description" content="<%= description %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/our-partners.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <!-- Page Header -->
    <section class="partners-page-header">
      <div class="container">
        <span class="eyebrow"><%= t.partners.eyebrow %></span>
        <div class="partners-page-header__inner">
          <h1><%- t.partners.h1 %></h1>
          <p><%= t.partners.lead %></p>
        </div>
      </div>
    </section>

    <!-- Partner Cards Grid -->
    <section class="partners-grid-section" aria-labelledby="partners-heading">
      <h2 id="partners-heading" class="sr-only"><%= t.partners.srHeading %></h2>
      <div class="container">
        <div class="partners-grid-wrap">

          <!-- ABLE -->
          <div class="partner-card" id="hotel-residential">
            <a href="<%= pfx %>/partners/able" class="partner-card__img-wrap" aria-label="View ABLE partner details">
              <img src="/images/partners-projects/able-hospitality-project.png" alt="Hotel & Residential furniture by ABLE" class="partner-card__img slider-img-1">
              <img src="/images/partners-projects/able-residential-project.png" alt="ABLE residential furniture" class="partner-card__img slider-img-2">
              <div class="partner-card__overlay"></div>
            </a>
            <div class="partner-card__body">
              <div class="partner-card__logo-wrap">
                <img src="/images/partners/Able-Partner.png" alt="ABLE Logo" class="partner-card__logo">
              </div>
              <div class="partner-card__text">
                <span class="partner-card__sector"><%= t.partners.secHotel %></span>
                <h3 class="partner-card__name">ABLE</h3>
                <span class="partner-card__origin"><%= t.partners.originAble %></span>
              </div>
              <div class="partner-card__actions">
                <a href="<%= pfx %>/partners/able" class="partner-card__link">
                  <%= t.partners.btnLearn %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a href="https://ablebemodern.com/" target="_blank" rel="noopener noreferrer" class="partner-card__link">
                  <%= t.partners.btnVisitAble %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Zivella -->
          <div class="partner-card" id="office-zivella">
            <a href="<%= pfx %>/partners/zivella" class="partner-card__img-wrap" aria-label="View Zivella partner details">
              <img src="/images/partners-projects/zivella-project.png" alt="Office furniture by Zivella" class="partner-card__img">
              <div class="partner-card__overlay"></div>
            </a>
            <div class="partner-card__body">
              <div class="partner-card__logo-wrap">
                <img src="/images/partners/Zivella-Partner.png" alt="Zivella Logo" class="partner-card__logo">
              </div>
              <div class="partner-card__text">
                <span class="partner-card__sector"><%= t.partners.secOffice %></span>
                <h3 class="partner-card__name">Zivella</h3>
                <span class="partner-card__origin"><%= t.partners.originZivella %></span>
              </div>
              <div class="partner-card__actions">
                <a href="<%= pfx %>/partners/zivella" class="partner-card__link">
                  <%= t.partners.btnLearn %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a href="https://www.zivella.com/" target="_blank" rel="noopener noreferrer" class="partner-card__link">
                  <%= t.partners.btnVisitZivella %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Falmar -->
          <div class="partner-card" id="office-falmar">
            <a href="<%= pfx %>/partners/falmar" class="partner-card__img-wrap" aria-label="View Falmar partner details">
              <img src="/images/partners-projects/falmar-project1.png" alt="Office partitions by Falmar" class="partner-card__img slider-img-1">
              <img src="/images/partners-projects/falmar-project2.png" alt="Falmar office furniture" class="partner-card__img slider-img-2">
              <div class="partner-card__overlay"></div>
            </a>
            <div class="partner-card__body">
              <div class="partner-card__logo-wrap">
                <img src="/images/partners/Falmar-Partner.png" alt="Falmar Logo" class="partner-card__logo">
              </div>
              <div class="partner-card__text">
                <span class="partner-card__sector"><%= t.partners.secPartitions %></span>
                <h3 class="partner-card__name">Falmar</h3>
                <span class="partner-card__origin"><%= t.partners.originFalmar %></span>
              </div>
              <div class="partner-card__actions">
                <a href="<%= pfx %>/partners/falmar" class="partner-card__link">
                  <%= t.partners.btnLearn %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a href="https://falmar.it/" target="_blank" rel="noopener noreferrer" class="partner-card__link">
                  <%= t.partners.btnVisitFalmar %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Bosco -->
          <div class="partner-card" id="control-rooms">
            <a href="<%= pfx %>/partners/bosco" class="partner-card__img-wrap" aria-label="View Bosco partner details">
              <img src="/images/partners-projects/bosco-project.png" alt="Control room furniture by Bosco" class="partner-card__img">
              <div class="partner-card__overlay"></div>
            </a>
            <div class="partner-card__body">
              <div class="partner-card__logo-wrap">
                <img src="/images/partners/Bosco-Partner.png" alt="Bosco Logo" class="partner-card__logo">
              </div>
              <div class="partner-card__text">
                <span class="partner-card__sector"><%= t.partners.secControl %></span>
                <h3 class="partner-card__name">Bosco</h3>
                <span class="partner-card__origin"><%= t.partners.originBosco %></span>
              </div>
              <div class="partner-card__actions">
                <a href="<%= pfx %>/partners/bosco" class="partner-card__link">
                  <%= t.partners.btnLearn %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a href="https://www.elettrobosco.com/en/" target="_blank" rel="noopener noreferrer" class="partner-card__link">
                  <%= t.partners.btnVisitBosco %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Healthcare — coming soon -->
          <div class="partner-card partner-card--soon" id="healthcare">
            <div class="partner-card__img-wrap">
              <div class="partner-card__overlay"></div>
            </div>
            <div class="partner-card__body">
              <div class="partner-card__text">
                <span class="partner-card__sector"><%= t.partners.secHealth %></span>
                <h3 class="partner-card__name"><%= t.partners.statusSoon %></h3>
                <span class="partner-card__origin"><%= t.partners.statusUnder %></span>
              </div>
              <span class="partner-card__soon-badge"><%= t.partners.badgeSoon %></span>
            </div>
          </div>

          <!-- Airports — coming soon -->
          <div class="partner-card partner-card--soon" id="airport-furniture">
            <div class="partner-card__img-wrap partner-card__img-wrap--placeholder">
            </div>
            <div class="partner-card__body">
              <div class="partner-card__text">
                <span class="partner-card__sector"><%= t.partners.secAirport %></span>
                <h3 class="partner-card__name"><%= t.partners.statusSoon %></h3>
                <span class="partner-card__origin"><%= t.partners.statusUnder %></span>
              </div>
              <span class="partner-card__soon-badge"><%= t.partners.badgeSoon %></span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-band" aria-labelledby="collections-cta-heading">
      <div class="container">
        <div class="cta-band__inner">
          <div class="cta-band__left">
            <h2 id="collections-cta-heading"><%- t.partners.ctaH2 %></h2>
          </div>
          <div class="cta-band__right">
            <p><%= t.partners.ctaText %></p>
            <div class="btn-row">
              <a href="<%= pfx %>/contact" class="btn btn--accent" id="collections-cta-contact"><%= t.partners.ctaContact %></a>
              <a href="<%= pfx %>/projects" class="btn btn--ghost" id="collections-cta-projects"><%= t.partners.ctaProjects %></a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.js"></script>
</body>
</html>