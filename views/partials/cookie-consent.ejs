<div class="cookie-consent" id="cookie-consent" role="dialog" aria-label="Cookie consent" aria-describedby="cookie-consent-text">
  <div class="cookie-consent__inner">
    <p class="cookie-consent__text" id="cookie-consent-text">
      This website uses essential cookies to ensure it functions correctly. We do not use tracking or advertising cookies unless you consent. Learn more in our <a href="/cookie-policy">Cookie Policy</a>.
    </p>
    <div class="cookie-consent__actions">
      <button class="cookie-consent__btn cookie-consent__btn--accept" id="cookie-accept" type="button">Accept</button>
      <button class="cookie-consent__btn cookie-consent__btn--decline" id="cookie-decline" type="button">Decline</button>
    </div>
  </div>
</div>
