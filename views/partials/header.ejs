<script>
  if (!sessionStorage.getItem('citadels_intro_played')) {
    document.documentElement.classList.add('do-intro');
  }
</script>

<style>
  :root {
    --intro-bg: #B3AFA5;
    --logo-fade-in: 0.6s;
    --logo-hold: 2s;
    --overlay-fade-out: 0.7s;
  }
  
  #site-intro-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999999;
    background-color: var(--intro-bg);
    align-items: center;
    justify-content: center;
    transition: opacity var(--overlay-fade-out) ease-in-out;
  }
  
  .do-intro #site-intro-overlay {
    display: flex;
  }
  
  /* Lock scroll */
  html.do-intro, html.do-intro body {
    overflow: hidden !important;
    height: 100vh;
  }
  
  #site-intro-logo {
    opacity: 0;
    transform: translateY(25px);
    width: 40%;
    max-width: 250px;
    mix-blend-mode: multiply;
    transition: opacity var(--logo-fade-in) ease-out, transform var(--logo-fade-in) ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    #site-intro-overlay { display: none !important; }
    html.do-intro, html.do-intro body { overflow: auto !important; height: auto; }
  }
</style>

<div id="site-intro-overlay">
  <img src="/images/logo.png" alt="The Citadels" id="site-intro-logo">
</div>

<script>
  (function() {
    if (document.documentElement.classList.contains('do-intro')) {
      const matchMedia = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (matchMedia && matchMedia.matches) {
         document.documentElement.classList.remove('do-intro');
         const ov = document.getElementById('site-intro-overlay');
         if (ov) ov.remove();
         return;
      }

      const overlay = document.getElementById('site-intro-overlay');
      const logo = document.getElementById('site-intro-logo');
      
      if (!overlay || !logo) return;

      setTimeout(() => {
        logo.style.opacity = '1';
        logo.style.transform = 'translateY(0)';
        
        setTimeout(() => {
          overlay.style.opacity = '0';
          
          setTimeout(() => {
            overlay.remove();
            document.documentElement.classList.remove('do-intro');
            sessionStorage.setItem('citadels_intro_played', 'true');
          }, 700);
          
        }, 2600);
      }, 200);
      
    } else {
      const overlay = document.getElementById('site-intro-overlay');
      if (overlay) overlay.remove();
    }
  })();
</script>

<a class="skip-link" href="#main-content">Skip to content</a>
