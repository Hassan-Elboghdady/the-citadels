<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= t.dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <meta name="description" content="<%= description %>">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/partner-detail.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <!-- Hero -->
    <div class="partner-hero">
      <img src="/images/partners-projects/able-hospitality-project.png" alt="Hotel & Residential High-End Furniture by ABLE" class="partner-hero__img hero-slider-img-1">
      <img src="/images/partners-projects/able-residential-project.png" alt="Hotel & Residential High-End Furniture by ABLE" class="partner-hero__img hero-slider-img-2">
      <div class="partner-hero__overlay"></div>
      <div class="partner-hero__content">
        <a href="<%= pfx %>/our-partners#hotel-residential" class="partner-hero__back partner-hero__back--desktop">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          <%= t.partnerDetail.back %>
        </a>
        <img src="/images/partners/Able-Partner.png" alt="ABLE" class="partner-hero__logo">
        <a href="#partner-body" class="partner-hero__scroll">
          <span><%= t.partnerDetail.scroll %></span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
      </div>
    </div>



    <!-- Body -->
    <section class="partner-body" id="partner-body">
      <div class="container">
        <!-- Mobile back button (hidden on desktop) -->
        <a href="<%= pfx %>/our-partners#hotel-residential" class="partner-hero__back partner-hero__back--mobile">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          <%= t.partnerDetail.back %>
        </a>
        <div class="partner-layout">

          <!-- Sidebar -->
          <aside class="partner-sidebar">
            <div class="partner-sidebar__card">
              <div class="partner-sidebar__logo-wrap">
                <img src="/images/partners/Able-Partner.png" alt="ABLE logo" class="partner-sidebar__logo">
              </div>
              <div class="partner-sidebar__info">
                <div class="partner-sidebar__row">
                  <span class="partner-sidebar__label"><%= t.partnerDetail.sidebarFullName %></span>
                  <span class="partner-sidebar__value"><%= t.partnerDetail.ableFullName %></span>
                </div>
                <div class="partner-sidebar__row">
                  <span class="partner-sidebar__label"><%= t.partnerDetail.sidebarSector %></span>
                  <span class="partner-sidebar__value"><%= t.partnerDetail.ableSector %></span>
                </div>
                <div class="partner-sidebar__row">
                  <span class="partner-sidebar__label"><%= t.partnerDetail.sidebarOrigin %></span>
                  <span class="partner-sidebar__value"><%= t.partnerDetail.ableOrigin %></span>
                </div>
                <div class="partner-sidebar__row">
                  <span class="partner-sidebar__label"><%= t.partnerDetail.sidebarExp %></span>
                  <span class="partner-sidebar__value"><%= t.partnerDetail.ableExp %></span>
                </div>
              </div>
            </div>
            <a href="https://ablebemodern.com/" class="btn btn--dark partner-sidebar__website" target="_blank" rel="noopener noreferrer" id="able-visit-website"><%= t.partnerDetail.ableVisit %></a>
            <a href="<%= pfx %>/our-partners#hotel-residential" class="btn btn--outline partner-sidebar__website" id="able-back-btn" style="margin-top: 10px;"><%= t.partnerDetail.backLink %></a>
          </aside>

          <!-- Content -->
          <div class="partner-content">
            <p class="partner-content__intro"><%= t.partnerDetail.ableIntro %></p>

            <p><%= t.partnerDetail.ableP2 %></p>

            <p><%= t.partnerDetail.ableP3 %></p>

            <p><%= t.partnerDetail.ableP4 %></p>
          </div>

        </div>

      </div>
    </section>

    <!-- Bottom CTA -->
    <div class="partner-cta">
      <div class="container">
        <div class="partner-cta__inner">
          <div>
            <h2><%= t.partnerDetail.ctaTitle %><br>ABLE <%= t.partnerDetail.ctaTitle2 %></h2>
          </div>
          <div>
            <p><%= t.partnerDetail.ctaText %></p>
            <div class="btn-row">
              <a href="<%= pfx %>/contact" class="btn btn--dark" id="able-cta-contact"><%= t.partnerDetail.ctaContact %></a>
              <a href="<%= pfx %>/our-partners" class="btn btn--outline" id="able-cta-back"><%= t.partnerDetail.ctaAll %></a>
            </div>
          </div>
        </div>
      </div>
    </div>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.js"></script>
</body>
</html>
