<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/partner-detail.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <!-- Hero -->
    <div class="partner-hero">
      <img src="/images/partners-projects/falmar-project1.png" alt="Office Furniture & Partitions by Falmar" class="partner-hero__img hero-slider-img-1">
      <img src="/images/partners-projects/falmar-project2.png" alt="Office Furniture & Partitions by Falmar" class="partner-hero__img hero-slider-img-2">
      <div class="partner-hero__overlay"></div>
      <div class="partner-hero__content">
        <a href="/our-partners#office-falmar" class="partner-hero__back">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          Our Partners
        </a>
        <span class="partner-hero__eyebrow">Office Furniture &amp; Partitions</span>
        <h1>Falmar</h1>
        <a href="#partner-body" class="partner-hero__scroll">
          <span>Scroll to find out more</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
      </div>
    </div>

    <!-- Dark meta strip -->
    <div class="partner-meta-strip">
      <div class="container">
        <div class="partner-meta-strip__inner">
          <div class="partner-meta-strip__item">
            <span class="partner-meta-strip__label">Country</span>
            <span class="partner-meta-strip__value">Italy (Pesaro)</span>
          </div>
          <div class="partner-meta-strip__sep"></div>
          <div class="partner-meta-strip__item">
            <span class="partner-meta-strip__label">Sector</span>
            <span class="partner-meta-strip__value">Office &amp; Partitions</span>
          </div>
          <div class="partner-meta-strip__sep"></div>
          <div class="partner-meta-strip__item">
            <span class="partner-meta-strip__label">Founded</span>
            <span class="partner-meta-strip__value">1990</span>
          </div>
          <div class="partner-meta-strip__sep"></div>
          <div class="partner-meta-strip__item">
            <span class="partner-meta-strip__label">Factory</span>
            <span class="partner-meta-strip__value">6,000 m²</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Body -->
    <section class="partner-body" id="partner-body">
      <div class="container">
        <div class="partner-layout">

          <!-- Sidebar -->
          <aside class="partner-sidebar">
            <div class="partner-sidebar__card">
              <div class="partner-sidebar__logo-wrap">
                <img src="/images/partners/Falmar-Partner.png" alt="Falmar logo" class="partner-sidebar__logo">
              </div>
              <div class="partner-sidebar__info">
                <div class="partner-sidebar__row">
                  <span class="partner-sidebar__label">Full Name</span>
                  <span class="partner-sidebar__value">Falmar Office Furniture</span>
                </div>
                <div class="partner-sidebar__row">
                  <span class="partner-sidebar__label">Sector</span>
                  <span class="partner-sidebar__value">Office Furniture &amp; Partitions</span>
                </div>
                <div class="partner-sidebar__row">
                  <span class="partner-sidebar__label">Origin</span>
                  <span class="partner-sidebar__value">Pesaro, Italy</span>
                </div>
                <div class="partner-sidebar__row">
                  <span class="partner-sidebar__label">Established</span>
                  <span class="partner-sidebar__value">1990</span>
                </div>
              </div>
            </div>
            <a href="https://falmar.it/" class="btn btn--dark partner-sidebar__website" target="_blank" rel="noopener noreferrer" id="falmar-visit-website">Visit Falmar Website →</a>
            <a href="/our-partners#office-falmar" class="btn btn--outline partner-sidebar__website" id="falmar-back-btn" style="margin-top: 10px;">← Back to Our Partners</a>
          </aside>

          <!-- Content -->
          <div class="partner-content">
            <p class="partner-content__intro">Falmar, established in Pesaro, Italy in 1990, is a specialist manufacturer of wall partitions, storage walls, and office furniture — operating from a fully integrated 6,000 m² production facility.</p>

            <p>Falmar manufactures full ranges of office furniture and offers new and innovative solutions designed to meet the constant evolution of the modern office world. Their activity is not limited to supplying standard furniture — they work alongside designers from the very first phases of each project.</p>

            <p>Tailor-made production is at the heart of what they do: leveraging their full production capacity to realize custom solutions for any project requiring unique pieces, combining aesthetic excellence with a strong price-quality ratio.</p>
          </div>

        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <div class="partner-cta">
      <div class="container">
        <div class="partner-cta__inner">
          <div>
            <h2>Interested in<br>Falmar Products?</h2>
          </div>
          <div>
            <p>Get in touch with The Citadels team and we will provide a detailed proposal including product specifications, pricing, and delivery timelines for your project.</p>
            <div class="btn-row">
              <a href="/contact" class="btn btn--dark" id="falmar-cta-contact">Contact Us</a>
              <a href="/our-partners" class="btn btn--outline" id="falmar-cta-back">View All Partners</a>
            </div>
          </div>
        </div>
      </div>
    </div>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.js"></script>
</body>
</html>
