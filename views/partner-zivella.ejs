<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/partner-detail.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <!-- Hero -->
    <div class="partner-hero">
      <img src="\images\partners-projects\zivella-project.png" alt="Office Furniture by Zivella" class="partner-hero__img">
      <div class="partner-hero__overlay"></div>
      <div class="partner-hero__content">
        <a href="/our-partners#office-zivella" class="partner-hero__back">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          Our Partners
        </a>
        <span class="partner-hero__eyebrow">Office Furniture</span>
        <h1>Zivella</h1>
        <a href="#partner-body" class="partner-hero__scroll">
          <span>Scroll to find out more</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
      </div>
    </div>

    <!-- Dark meta strip -->
    <div class="partner-meta-strip">
      <div class="container">
        <div class="partner-meta-strip__inner">
          <div class="partner-meta-strip__item">
            <span class="partner-meta-strip__label">Country</span>
            <span class="partner-meta-strip__value">Turkey (Istanbul)</span>
          </div>
          <div class="partner-meta-strip__sep"></div>
          <div class="partner-meta-strip__item">
            <span class="partner-meta-strip__label">Sector</span>
            <span class="partner-meta-strip__value">Office Furniture</span>
          </div>
          <div class="partner-meta-strip__sep"></div>
          <div class="partner-meta-strip__item">
            <span class="partner-meta-strip__label">Experience</span>
            <span class="partner-meta-strip__value">25+ Years</span>
          </div>
          <div class="partner-meta-strip__sep"></div>
          <div class="partner-meta-strip__item">
            <span class="partner-meta-strip__label">Export Markets</span>
            <span class="partner-meta-strip__value">50+ Countries</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Body -->
    <section class="partner-body" id="partner-body">
      <div class="container">
        <div class="partner-layout">

          <!-- Sidebar -->
          <aside class="partner-sidebar">
            <div class="partner-sidebar__card">
              <div class="partner-sidebar__logo-wrap">
                <img src="/images/partners/Zivella-Partner.png" alt="Zivella logo" class="partner-sidebar__logo">
              </div>
              <div class="partner-sidebar__info">
                <div class="partner-sidebar__row">
                  <span class="partner-sidebar__label">Full Name</span>
                  <span class="partner-sidebar__value">Zivella Office Furniture</span>
                </div>
                <div class="partner-sidebar__row">
                  <span class="partner-sidebar__label">Sector</span>
                  <span class="partner-sidebar__value">Office Furniture</span>
                </div>
                <div class="partner-sidebar__row">
                  <span class="partner-sidebar__label">Origin</span>
                  <span class="partner-sidebar__value">Istanbul, Turkey</span>
                </div>
                <div class="partner-sidebar__row">
                  <span class="partner-sidebar__label">Team</span>
                  <span class="partner-sidebar__value">250 Specialized Employees</span>
                </div>
              </div>
            </div>
            <a href="https://www.zivella.com/" class="btn btn--dark partner-sidebar__website" target="_blank" rel="noopener noreferrer" id="zivella-visit-website">Visit Zivella Website →</a>
            <a href="/our-partners#office-zivella" class="btn btn--outline partner-sidebar__website" id="zivella-back-btn" style="margin-top: 10px;">← Back to Our Partners</a>
          </aside>

          <!-- Content -->
          <div class="partner-content">
            <p class="partner-content__intro">Zivella has been crafting premium office furniture from Istanbul for over 25 years — exporting to nearly 50 countries with a dedicated team of 250 specialized employees.</p>

            <p>With our renowned designers both in Turkey and worldwide, we create designs that promote well-being for both the body and soul, supporting our users in feeling good.</p>

            <p>Our design approach reflects life, nature, culture, people, and colors. We strive to transform offices, workspaces, and waiting areas into enjoyable and peaceful living spaces with the quality and aesthetics of our products.</p>

            <p>As Zivella, we combine the beauty of life with functional designs and enable spaces to breathe — creating environments where people feel motivated, comfortable, and inspired.</p>
          </div>

        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <div class="partner-cta">
      <div class="container">
        <div class="partner-cta__inner">
          <div>
            <h2>Interested in<br>Zivella Products?</h2>
          </div>
          <div>
            <p>Get in touch with The Citadels team and we will provide a detailed proposal including product specifications, pricing, and delivery timelines for your project.</p>
            <div class="btn-row">
              <a href="/contact" class="btn btn--dark" id="zivella-cta-contact">Contact Us</a>
              <a href="/our-partners" class="btn btn--outline" id="zivella-cta-back">View All Partners</a>
            </div>
          </div>
        </div>
      </div>
    </div>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.js"></script>
</body>
</html>
