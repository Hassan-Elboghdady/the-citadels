<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= t.dir %>">
<%
  function tField(obj, field) {
    if (!obj) return '';
    const val = obj[field + '_' + lang];
    return val ? val : obj[field];
  }
%>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/project-detail.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <section class="pd-section">
      <div class="container">

        <!-- Top bar: Back link only (scroll hint removed) -->
        <div class="pd-top-bar">
          <a href="<%= pfx %>/projects#<%= project.slug %>" class="pd-back">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            <%= t.projects.pdBack %>
          </a>
        </div>

        <!-- Main content: image/slider left, details right -->
        <div class="pd-body">

          <div class="pd-image-col">
            <% if (project.gallery && project.gallery.length > 0) { %>
              <!-- Inline gallery slider replaces static image -->
              <div class="pd-inline-slider" id="inlineSliderWrap">

                <!-- Prev arrow -->
                <button class="pd-inline-arrow pd-inline-arrow--left" id="inlinePrev" aria-label="Previous photo">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                </button>

                <!-- Track -->
                <div class="pd-inline-track-wrap">
                  <div class="pd-inline-track" id="inlineTrack">
                    <% project.gallery.forEach(function(img, i) { %>
                      <div class="pd-inline-slide">
                        <img
                          src="<%= img %>"
                          alt="<%= tField(project, 'name') %> — photo <%= i + 1 %>"
                          class="pd-inline-img"
                          data-index="<%= i %>"
                          role="button"
                          tabindex="0"
                          aria-label="View full photo <%= i + 1 %>"
                          style="cursor: zoom-in;"
                        >
                      </div>
                    <% }); %>
                  </div>
                </div>

                <!-- Next arrow -->
                <button class="pd-inline-arrow pd-inline-arrow--right" id="inlineNext" aria-label="Next photo">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                </button>

                <!-- Dot indicators -->
                <div class="pd-inline-dots" id="inlineDots"></div>

                <!-- Counter -->
                <div class="pd-inline-counter"><span id="inlineCurrent">1</span> / <%= project.gallery.length %></div>
              </div>
            <% } else { %>
              <!-- Fallback: single image -->
              <div class="pd-image-wrap">
                <img src="<%= project.image %>" alt="<%= tField(project, 'name') %>" class="pd-image" id="mainProjImg" style="cursor: zoom-in;" role="button" aria-label="View full photo" tabindex="0">
              </div>
            <% } %>
          </div>

          <div class="pd-info-col">
            <% if (tField(project, 'subtitle')) { %>
              <p class="pd-subtitle"><%= tField(project, 'subtitle') %></p>
            <% } %>
            <h1 class="pd-title"><%= tField(project, 'name') %></h1>

            <div class="pd-meta">
              <div class="pd-meta-row">
                <span class="pd-meta-label"><%= t.projects.pdSector %></span>
                <span class="pd-meta-value"><%= tField(project, 'sector') %></span>
              </div>
              <div class="pd-meta-row">
                <span class="pd-meta-label"><%= t.projects.pdLocation %></span>
                <span class="pd-meta-value"><%= tField(project, 'location') %></span>
              </div>
          </div>

        </div>

      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.js"></script>

  <% if (project.gallery && project.gallery.length > 0) { %>
  <!-- Lightbox -->
  <div class="pd-lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Full size photo">
    <button class="pd-lightbox__close" id="lightboxClose" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <button class="pd-lightbox__arrow pd-lightbox__arrow--left" id="lightboxPrev" aria-label="Previous">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="pd-lightbox__img-wrap">
      <img src="" alt="" class="pd-lightbox__img" id="lightboxImg">
    </div>
    <button class="pd-lightbox__arrow pd-lightbox__arrow--right" id="lightboxNext" aria-label="Next">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
    </button>
    <p class="pd-lightbox__counter"><span id="lightboxNum">1</span> / <%= project.gallery.length %></p>
  </div>

  <script>
  (function() {
    const galleryImgs = <%- JSON.stringify(project.gallery) %>;
    const total       = galleryImgs.length;

    /* ── Inline Slider ── */
    const track       = document.getElementById('inlineTrack');
    const dotsWrap    = document.getElementById('inlineDots');
    const prevBtn     = document.getElementById('inlinePrev');
    const nextBtn     = document.getElementById('inlineNext');
    const currentSpan = document.getElementById('inlineCurrent');
    let current = 0;
    let dots = [];

    function buildDots() {
      dotsWrap.innerHTML = '';
      dots = [];
      // Only show dots if 10 or fewer images (otherwise just use counter)
      if (total <= 10) {
        dotsWrap.style.display = 'flex';
        for (let i = 0; i < total; i++) {
          const d = document.createElement('button');
          d.className = 'pd-inline-dot' + (i === 0 ? ' is-active' : '');
          d.setAttribute('aria-label', 'Go to photo ' + (i + 1));
          d.addEventListener('click', () => goTo(i));
          dotsWrap.appendChild(d);
          dots.push(d);
        }
      } else {
        dotsWrap.style.display = 'none';
      }
    }

    function goTo(index) {
      current = (index + total) % total;
      track.style.transform = `translateX(-${current * 100}%)`;
      if (currentSpan) currentSpan.textContent = current + 1;
      dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
    }

    buildDots();

    prevBtn.addEventListener('click', () => goTo(current - 1));
    nextBtn.addEventListener('click', () => goTo(current + 1));

    // Touch swipe
    const wrap = document.getElementById('inlineSliderWrap');
    let touchStartX = 0;
    wrap.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
    wrap.addEventListener('touchend', e => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
    });

    /* ── Lightbox ── */
    const lightbox = document.getElementById('lightbox');
    const lbImg    = document.getElementById('lightboxImg');
    const lbNum    = document.getElementById('lightboxNum');
    const lbClose  = document.getElementById('lightboxClose');
    const lbPrev   = document.getElementById('lightboxPrev');
    const lbNext   = document.getElementById('lightboxNext');
    let lbCurrent  = 0;

    function openLightbox(index) {
      lbCurrent = (index + total) % total;
      lbImg.src = galleryImgs[lbCurrent];
      lbNum.textContent = lbCurrent + 1;
      lightbox.classList.add('is-open');
    }
    function closeLightbox() { lightbox.classList.remove('is-open'); }
    function lbGoTo(index) {
      lbCurrent = (index + total) % total;
      lbImg.style.opacity = '0';
      setTimeout(() => {
        lbImg.src = galleryImgs[lbCurrent];
        lbImg.style.opacity = '1';
        lbNum.textContent = lbCurrent + 1;
      }, 150);
    }

    // Click on slider images opens lightbox
    document.querySelectorAll('.pd-inline-img').forEach(img => {
      img.addEventListener('click', () => openLightbox(+img.dataset.index));
      img.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') openLightbox(+img.dataset.index); });
    });

    lbClose.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', e => { if (e.target === lightbox) closeLightbox(); });
    lbPrev.addEventListener('click', e => { e.stopPropagation(); lbGoTo(lbCurrent - 1); });
    lbNext.addEventListener('click', e => { e.stopPropagation(); lbGoTo(lbCurrent + 1); });

    document.addEventListener('keydown', e => {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape')     closeLightbox();
      if (e.key === 'ArrowLeft')  lbGoTo(lbCurrent - 1);
      if (e.key === 'ArrowRight') lbGoTo(lbCurrent + 1);
    });
  })();
  </script>
  <% } %>
</body>
</html>
