<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= t.dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <meta name="description" content="<%= description %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/projects.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <!-- Page Header -->
    <section class="proj-page-header">
      <div class="container">
        <span class="eyebrow"><%= t.projects.eyebrow %></span>
        <div class="proj-page-header__inner">
          <h1><%- t.projects.h1 %></h1>
          <p><%= t.projects.lead %></p>
        </div>
      </div>
    </section>


    <!-- Projects List -->
    <section class="proj-list" aria-label="Our projects">

      <!-- Project 01 -->
      <a id="ncc-monorail-depot-buildings"
         href="<%= pfx %>/projects/ncc-monorail-depot-buildings"
         class="proj-row"
         aria-label="View NCC Monorail Depot Buildings">
        <div class="proj-row__img-col">
          <div class="proj-row__img-wrap">
            <img src="/images/our-projects/ncc-monorail-depot-buildings/100_4770.JPG"
                 alt="NCC Monorail Depot Buildings" class="proj-row__img">
          </div>
        </div>
        <div class="proj-row__info">
          <span class="proj-row__num" style="visibility: hidden;" aria-hidden="true">01</span>
          <div class="proj-row__text">
            <span class="proj-row__sector"><%= t.projects.proj1Sector %></span>
            <h2 class="proj-row__title"><%- t.projects.proj1Title %></h2>
            <span class="proj-row__subtitle"><%= t.projects.proj1Subtitle %></span>
            <span class="proj-row__location"><%= t.projects.proj1Loc %></span>
            <span class="proj-row__link">
              <%= t.projects.btnView %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </div>
      </a>

      <!-- Project 02 -->
      <a id="ncc-monorail-stations"
         href="<%= pfx %>/projects/ncc-monorail-stations"
         class="proj-row proj-row--reverse"
         aria-label="View NCC Monorail Stations">
        <div class="proj-row__img-col">
          <div class="proj-row__img-wrap">
            <img src="/images/our-projects/ncc-monorail-stations/STATION ELEVATION.JPG"
                 alt="NCC Monorail Stations" class="proj-row__img">
          </div>
        </div>
        <div class="proj-row__info">
          <span class="proj-row__num" style="visibility: hidden;" aria-hidden="true">02</span>
          <div class="proj-row__text">
            <span class="proj-row__sector"><%= t.projects.proj2Sector %></span>
            <h2 class="proj-row__title"><%- t.projects.proj2Title %></h2>
            <span class="proj-row__subtitle"><%= t.projects.proj2Subtitle %></span>
            <span class="proj-row__location"><%= t.projects.proj2Loc %></span>
            <span class="proj-row__link">
              <%= t.projects.btnView %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </div>
      </a>

      <!-- Project 03 -->
      <a id="west-nile-monorail"
         href="<%= pfx %>/projects/west-nile-monorail"
         class="proj-row"
         aria-label="View West Nile Monorail">
        <div class="proj-row__img-col">
          <div class="proj-row__img-wrap">
            <img src="/images/our-projects/west-nile-monorail/mono.jpg"
                 alt="West Nile Monorail OCC Control Consoles" class="proj-row__img">
          </div>
        </div>
        <div class="proj-row__info">
          <span class="proj-row__num" style="visibility: hidden;" aria-hidden="true">03</span>
          <div class="proj-row__text">
            <span class="proj-row__sector"><%= t.projects.proj3Sector %></span>
            <h2 class="proj-row__title"><%- t.projects.proj3Title %></h2>
            <span class="proj-row__subtitle"><%= t.projects.proj3Subtitle %></span>
            <span class="proj-row__location"><%= t.projects.proj3Loc %></span>
            <span class="proj-row__link">
              <%= t.projects.btnView %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </div>
      </a>

    </section>

    <!-- CTA -->
    <section class="cta-band" aria-labelledby="proj-cta-heading">
      <div class="container">
        <div class="cta-band__inner">
          <div class="cta-band__left">
            <h2 id="proj-cta-heading"><%- t.projects.ctaH2 %></h2>
          </div>
          <div class="cta-band__right">
            <p><%= t.projects.ctaText %></p>
            <div class="btn-row">
              <a href="<%= pfx %>/contact" class="btn btn--accent" id="proj-cta-contact"><%= t.projects.ctaContact %></a>
              <a href="/brochure/the-citadels-brochure.pdf" target="_blank" rel="noopener noreferrer" class="btn btn--ghost" id="proj-cta-brochure"><%= t.projects.ctaBrochure %></a>
              <a href="<%= pfx %>/our-partners" class="btn btn--ghost" id="proj-cta-partners"><%= t.projects.ctaPartners %></a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.js"></script>
</body>
</html>
