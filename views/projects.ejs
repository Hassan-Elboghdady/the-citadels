<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/projects.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <!-- Intro -->
    <div class="proj-intro">
      <div class="container">
        <div class="proj-intro__inner">
          <div class="proj-intro__left">
            <span class="eyebrow">Our Work</span>
            <h1>Projects &amp;<br>Experience</h1>
          </div>
          <div class="proj-intro__right">
            <p>From proton therapy facilities to monorail control rooms and 5-star hospitality, we deliver premium furniture solutions for environments where quality is not optional.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="proj-stats">
      <div class="container">
        <div class="proj-stats__inner">
          <div class="proj-stats__item">
            <span class="proj-stats__num">50+</span>
            <span class="proj-stats__label">Projects Completed</span>
          </div>
          <div class="proj-stats__item">
            <span class="proj-stats__num">6</span>
            <span class="proj-stats__label">Sectors Served</span>
          </div>
          <div class="proj-stats__item">
            <span class="proj-stats__num">30+</span>
            <span class="proj-stats__label">Years of Experience</span>
          </div>
          <div class="proj-stats__item">
            <span class="proj-stats__num">100%</span>
            <span class="proj-stats__label">European Brands</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Project Grid -->
    <section class="proj-grid-section" aria-labelledby="proj-heading">
      <div class="container">

        <div class="proj-grid">

          <!-- NCC Monorail Control Rooms -->
          <a id="ncc-monorail-control-rooms" href="/projects/ncc-monorail-control-rooms" class="proj-card" aria-label="View NCC Monorail Control Rooms project">
            <span class="proj-card__label">NCC Monorail Control Rooms</span>
            <div class="proj-card__img-wrap">
              <img src="/images/control-room.png" alt="NCC Monorail Control Room with ergonomic consoles" class="proj-card__img">
            </div>
          </a>

          <!-- West Nile Monorail Control Rooms -->
          <a id="west-nile-monorail-control-rooms" href="/projects/west-nile-monorail-control-rooms" class="proj-card" aria-label="View West Nile Monorail Control Rooms project">
            <span class="proj-card__label">West Nile Monorail Control Rooms</span>
            <div class="proj-card__img-wrap">
              <img src="/images/control-room.png" alt="West Nile Monorail Control Room furniture" class="proj-card__img">
            </div>
          </a>

          <!-- NCC Monorail Furniture -->
          <a id="ncc-monorail-furniture" href="/projects/ncc-monorail-furniture" class="proj-card" aria-label="View NCC Monorail Furniture project">
            <span class="proj-card__label">NCC Monorail Furniture</span>
            <div class="proj-card__img-wrap">
              <img src="/images/office.png" alt="NCC Monorail station office furniture" class="proj-card__img">
            </div>
          </a>

          <!-- West Nile Monorail Furniture -->
          <a id="west-nile-monorail-furniture" href="/projects/west-nile-monorail-furniture" class="proj-card" aria-label="View West Nile Monorail Furniture project">
            <span class="proj-card__label">West Nile Monorail Furniture</span>
            <div class="proj-card__img-wrap">
              <img src="/images/office.png" alt="West Nile Monorail station furniture" class="proj-card__img">
            </div>
          </a>

          <!-- 5-Star Hotel Project -->
          <a id="five-star-hotel-project" href="/projects/five-star-hotel-project" class="proj-card" aria-label="View 5-Star Hotel Project">
            <span class="proj-card__label">Star Hotel Project</span>
            <div class="proj-card__img-wrap">
              <img src="/images/partners-projects/able-hospitality-project.png" alt="5-Star Hotel Hospitality Furniture by ABLE" class="proj-card__img">
            </div>
          </a>

        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-band" aria-labelledby="proj-cta-heading">
      <div class="container">
        <div class="cta-band__inner">
          <div class="cta-band__left">
            <h2 id="proj-cta-heading">Discuss Your<br>Project</h2>
          </div>
          <div class="cta-band__right">
            <p>Whether you need furniture for a single space or a large-scale infrastructure project, our team can help with sourcing, specification, and delivery.</p>
            <div class="btn-row">
              <a href="/contact" class="btn btn--accent" id="proj-cta-contact">Contact Us</a>
              <a href="/our-partners" class="btn btn--ghost" id="proj-cta-partners">Our Partners</a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.js"></script>
</body>
</html>
