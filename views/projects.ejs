<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/projects.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">

    <!-- Page Header -->
    <section class="proj-page-header">
      <div class="container">
        <span class="eyebrow">Our Work</span>
        <div class="proj-page-header__inner">
          <h1>Projects &amp;<br>Experience</h1>
          <p>From monorail control rooms to station environments — precision-specified, European-sourced furniture for Egypt's most demanding infrastructure projects.</p>
        </div>
      </div>
    </section>


    <!-- Projects List -->
    <section class="proj-list" aria-label="Our projects">

      <!-- Project 01 -->
      <a id="ncc-monorail-depot-buildings"
         href="/projects/ncc-monorail-depot-buildings"
         class="proj-row"
         aria-label="View NCC Monorail Depot Buildings">
        <div class="proj-row__img-col">
          <div class="proj-row__img-wrap">
            <img src="/images/our-projects/ncc-monorail-depot-buildings/100_4770.JPG"
                 alt="NCC Monorail Depot Buildings" class="proj-row__img">
          </div>
        </div>
        <div class="proj-row__info">
          <span class="proj-row__num" style="visibility: hidden;" aria-hidden="true">01</span>
          <div class="proj-row__text">
            <span class="proj-row__sector">Transport / Control Room</span>
            <h2 class="proj-row__title">NCC Monorail<br>Depot Buildings</h2>
            <span class="proj-row__location">New Capital City · New Cairo · Nasr City</span>
            <span class="proj-row__link">
              View Project
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </div>
      </a>

      <!-- Project 02 -->
      <a id="ncc-monorail-stations"
         href="/projects/ncc-monorail-stations"
         class="proj-row proj-row--reverse"
         aria-label="View NCC Monorail Stations">
        <div class="proj-row__img-col">
          <div class="proj-row__img-wrap">
            <img src="/images/our-projects/ncc-monorail-stations/STATION ELEVATION.JPG"
                 alt="NCC Monorail Stations" class="proj-row__img">
          </div>
        </div>
        <div class="proj-row__info">
          <span class="proj-row__num" style="visibility: hidden;" aria-hidden="true">02</span>
          <div class="proj-row__text">
            <span class="proj-row__sector">Transport / Control Room</span>
            <h2 class="proj-row__title">NCC Monorail<br>Stations</h2>
            <span class="proj-row__location">New Capital City · New Cairo · Nasr City</span>
            <span class="proj-row__link">
              View Project
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </div>
      </a>

      <!-- Project 03 -->
      <a id="west-nile-monorail"
         href="/projects/west-nile-monorail"
         class="proj-row"
         aria-label="View West Nile Monorail">
        <div class="proj-row__img-col">
          <div class="proj-row__img-wrap">
            <img src="/images/our-projects/west-nile-monorail/mono.jpg"
                 alt="West Nile Monorail OCC Control Consoles" class="proj-row__img">
          </div>
        </div>
        <div class="proj-row__info">
          <span class="proj-row__num" style="visibility: hidden;" aria-hidden="true">03</span>
          <div class="proj-row__text">
            <span class="proj-row__sector">Transport / Control Room</span>
            <h2 class="proj-row__title">West Nile<br>Monorail</h2>
            <span class="proj-row__location">Giza · 6th of October City</span>
            <span class="proj-row__link">
              View Project
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </div>
      </a>

    </section>

    <!-- CTA -->
    <section class="cta-band" aria-labelledby="proj-cta-heading">
      <div class="container">
        <div class="cta-band__inner">
          <div class="cta-band__left">
            <h2 id="proj-cta-heading">Discuss Your<br>Project</h2>
          </div>
          <div class="cta-band__right">
            <p>Whether you need furniture for a single space or a large-scale infrastructure project, our team can help with sourcing, specification, and delivery.</p>
            <div class="btn-row">
              <a href="/contact" class="btn btn--accent" id="proj-cta-contact">Contact Us</a>
              <a href="/our-partners" class="btn btn--ghost" id="proj-cta-partners">Our Partners</a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
  <%- include('partials/cookie-consent') %>
  <script src="/js/main.js"></script>
</body>
</html>
