<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="Create your account with The Citadels.">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">
    <section class="auth-section" aria-labelledby="signup-heading">
      <div class="container">
        <div class="auth-layout">

          <!-- Left: branding panel -->
          <div class="auth-brand">
            <img src="/images/logo.png" alt="The Citadels" class="auth-brand__logo">
            <p class="auth-brand__text">Create an account to place orders, track project inquiries, and access exclusive collections.</p>
          </div>

          <!-- Right: form -->
          <div class="auth-form-wrap">
            <h1 id="signup-heading" class="auth-title">Create Account</h1>
            <p class="auth-subtitle">Already have an account? <a href="/login">Sign in</a></p>

            <% if (errors.general) { %>
              <div class="auth-alert auth-alert--error" role="alert">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M10 6v5M10 13.5v.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <%= errors.general %>
              </div>
            <% } %>

            <form class="auth-form" id="signup-form" action="/signup" method="POST" novalidate>

              <div class="form-row">
                <div class="form-group">
                  <label for="signup-first-name" class="form-label form-label--required">First Name</label>
                  <input type="text" id="signup-first-name" name="firstName" class="form-input<%= errors.firstName ? ' form-input--error' : '' %>" required autocomplete="given-name" value="<%= formData.firstName || '' %>">
                  <% if (errors.firstName) { %><p class="form-error" role="alert"><%= errors.firstName %></p><% } %>
                </div>
                <div class="form-group">
                  <label for="signup-last-name" class="form-label form-label--required">Last Name</label>
                  <input type="text" id="signup-last-name" name="lastName" class="form-input<%= errors.lastName ? ' form-input--error' : '' %>" required autocomplete="family-name" value="<%= formData.lastName || '' %>">
                  <% if (errors.lastName) { %><p class="form-error" role="alert"><%= errors.lastName %></p><% } %>
                </div>
              </div>

              <div class="form-group">
                <label for="signup-email" class="form-label form-label--required">Email Address</label>
                <input type="email" id="signup-email" name="email" class="form-input<%= errors.email ? ' form-input--error' : '' %>" required autocomplete="email" value="<%= formData.email || '' %>">
                <% if (errors.email) { %><p class="form-error" role="alert"><%= errors.email %></p><% } %>
              </div>

              <div class="form-group">
                <label for="signup-phone" class="form-label form-label--required">Phone Number</label>
                <input type="tel" id="signup-phone" name="phone" class="form-input<%= errors.phone ? ' form-input--error' : '' %>" required autocomplete="tel" placeholder="+20 XXX XXX XXXX" value="<%= formData.phone || '' %>">
                <% if (errors.phone) { %><p class="form-error" role="alert"><%= errors.phone %></p><% } %>
              </div>

              <div class="form-group">
                <label for="signup-password" class="form-label form-label--required">Password</label>
                <div class="password-wrap">
                  <input type="password" id="signup-password" name="password" class="form-input<%= errors.password ? ' form-input--error' : '' %>" required autocomplete="new-password" minlength="8">
                  <button type="button" class="password-toggle" aria-label="Show password" data-target="signup-password">
                    <svg class="eye-open" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M1 10s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6z" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="10" r="3" stroke="currentColor" stroke-width="1.5"/></svg>
                    <svg class="eye-closed" width="18" height="18" viewBox="0 0 20 20" fill="none" style="display:none"><path d="M1 10s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6z" stroke="currentColor" stroke-width="1.5"/><path d="M3 3l14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  </button>
                </div>
                <div class="password-strength" id="password-strength" aria-live="polite">
                  <div class="password-strength__bar"><div class="password-strength__fill" id="strength-fill"></div></div>
                  <span class="password-strength__label" id="strength-label"></span>
                </div>
                <% if (errors.password) { %><p class="form-error" role="alert"><%= errors.password %></p><% } %>
                <ul class="password-rules" id="password-rules">
                  <li data-rule="length">At least 8 characters</li>
                  <li data-rule="upper">One uppercase letter</li>
                  <li data-rule="lower">One lowercase letter</li>
                  <li data-rule="digit">One number</li>
                  <li data-rule="special">One special character</li>
                </ul>
              </div>

              <div class="form-group">
                <label for="signup-confirm" class="form-label form-label--required">Confirm Password</label>
                <div class="password-wrap">
                  <input type="password" id="signup-confirm" name="confirmPassword" class="form-input<%= errors.confirmPassword ? ' form-input--error' : '' %>" required autocomplete="new-password">
                  <button type="button" class="password-toggle" aria-label="Show password" data-target="signup-confirm">
                    <svg class="eye-open" width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M1 10s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6z" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="10" r="3" stroke="currentColor" stroke-width="1.5"/></svg>
                    <svg class="eye-closed" width="18" height="18" viewBox="0 0 20 20" fill="none" style="display:none"><path d="M1 10s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6z" stroke="currentColor" stroke-width="1.5"/><path d="M3 3l14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  </button>
                </div>
                <% if (errors.confirmPassword) { %><p class="form-error" role="alert"><%= errors.confirmPassword %></p><% } %>
              </div>

              <div class="form-group">
                <label class="form-checkbox-label form-consent">
                  <input type="checkbox" name="terms" id="signup-terms" required>
                  <span>I agree to The Citadels <a href="/terms">Terms &amp; Conditions</a> and <a href="/privacy-policy">Privacy Policy</a>.</span>
                </label>
              </div>

              <button type="submit" class="btn btn--dark auth-submit" id="signup-submit">Create Account</button>
            </form>
          </div>

        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
  <script src="/js/auth.js"></script>
</body>
</html>
