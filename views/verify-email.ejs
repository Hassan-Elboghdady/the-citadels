<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="robots" content="noindex">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <%- include('partials/header') %>

  <main id="main-content">
    <section class="auth-section" aria-labelledby="verify-heading">
      <div class="container">
        <div class="auth-success-wrap">
          <% if (status === 'success') { %>
            <div class="auth-success-icon" aria-hidden="true">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="2"/><path d="M14 24l7 7 13-13" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          <% } else { %>
            <div class="auth-success-icon auth-success-icon--error" aria-hidden="true">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="2"/><path d="M17 17l14 14M31 17L17 31" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
            </div>
          <% } %>
          <h1 id="verify-heading" class="auth-title"><%= status === 'success' ? 'Email Verified' : 'Verification Failed' %></h1>
          <p class="auth-subtitle" style="max-width: 440px; margin: 0 auto;"><%= message %></p>
          <a href="<%= status === 'success' ? '/' : '/login' %>" class="btn btn--dark" style="margin-top: 32px;"><%= status === 'success' ? 'Go to Home' : 'Go to Sign In' %></a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
